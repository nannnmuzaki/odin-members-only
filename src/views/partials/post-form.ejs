<form class="box-form" method="POST" action="/posts/new">
  <%- include("form-errors") %>
  <div class="input-wrapper">
    <label for="title">Title</label>
    <input type="text" name="title" id="title" placeholder="Enter a title"
      value="<%= locals.values?.title || "" %>" required maxlength="255">
  </div>
  <div class="input-wrapper">
    <label for="text">Text</label>
    <textarea name="text" id="text" placeholder="Write your post"
      required maxlength="2000"><%= locals.values?.text || "" %></textarea>
  </div>
  <div class="form-btn">
    <button type="reset">Reset</button>
    <button type="submit">Post</button>
  </div>
</form>
