<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Sign Up | Members Only</title>
  </head>
  <body>
    <div class="root">
      <%- include("../partials/header") %>
      <main>
        <div class="form-page">
          <div class="page-heading">
            <h1>Sign Up</h1>
            <a class="new-btn" href="/">Cancel</a>
          </div>
          <form class="box-form" method="POST" action="/auth/signup">
            <%- include("../partials/form-errors") %>
            <div class="input-wrapper">
              <label for="name">Full name</label>
              <input type="text" name="name" id="name" placeholder="Enter your full name"
                value="<%= locals.values?.name || "" %>" required maxlength="255">
            </div>
            <div class="input-wrapper">
              <label for="email">Email</label>
              <input type="email" name="email" id="email" placeholder="you@example.com"
                value="<%= locals.values?.email || "" %>" required maxlength="255">
            </div>
            <div class="input-wrapper">
              <label for="password">Password</label>
              <input type="password" name="password" id="password"
                placeholder="At least 8 chars, upper, lower, number, symbol" required>
            </div>
            <div class="input-wrapper">
              <label for="confirmPassword">Confirm password</label>
              <input type="password" name="confirmPassword" id="confirmPassword"
                placeholder="Type the same password again" required>
            </div>
            <div class="form-btn">
              <button type="reset">Reset</button>
              <button type="submit">Sign Up</button>
            </div>
          </form>
          <p class="form-foot">
            Already have an account? <a href="/auth/login">Log in</a>.
          </p>
        </div>
      </main>
      <%- include("../partials/footer") %>
    </div>
  </body>
</html>
